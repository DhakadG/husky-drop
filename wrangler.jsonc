{
  "name": "husky-drop",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/d/*", "/s/*", "/admin"]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "74e8b6bf9b6d42cda0ddadd2e78f9e77",
      "remote": true
    }
  ],
  // Media cache ladder (docs/superpowers/specs/2026-09-20-media-cache-ladder-design.md):
  // thumbnails, 720p previews and folder-stats blobs. Content-addressed keys;
  // the bucket carries 30-day lifecycle rules on media/ and stats/.
  //   npx wrangler r2 bucket create husky-drop-media
  //   npx wrangler r2 bucket lifecycle add husky-drop-media --name media-30d --prefix media/ --expire-days 30
  //   npx wrangler r2 bucket lifecycle add husky-drop-media --name stats-30d --prefix stats/ --expire-days 30
  // share-index chunks continue by calling this Worker through a binding to
  // itself: a plain fetch() to our own hostname is refused (error 1042).
  "services": [{ "binding": "SELF", "service": "husky-drop" }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "husky-drop-media" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_TRACKER",
        "class_name": "LiveTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-live-tracker",
      "new_sqlite_classes": ["LiveTracker"]
    }
  ],
  "vars": {
    // GITHUB_TOKEN (secret, optional): fine-grained PAT with Actions read/write
    // so the admin can dispatch the preview transcoder. GITHUB_REPO var
    // overrides the default DhakadG/husky-drop.
    // DRIVE_PARENT_ID is a secret, not a var — set it with:
    //   wrangler secret put DRIVE_PARENT_ID
    // Optional: Drive folder ID that new per-link folders are created inside.
    // Unset means folders are created in My Drive root.
    // Cloudflare Web Analytics beacon token; the Worker injects the snippet
    // into every HTML page when set. Public by design, not a secret.
    "CF_BEACON_TOKEN": "5e7e086782714160804ea9afc63dedc8",
    // Microsoft Clarity project id; the Worker injects the snippet into
    // every HTML page when set. Public by design, not a secret.
    "CLARITY_PROJECT_ID": "xjtpz5cm04",
    // share-index (media-cache spec §4/§8.3): chunked walks re-invoke the
    // Worker at this origin; INDEX_CHUNK = subrequests per chunk (40 fits the
    // Free plan; 200 on the current Paid plan); CHANGE_WINDOW_SEC = how often changes.list
    // may be polled; INDEX_SCHEDULE = global full-walk cadence.
    "SELF_ORIGIN": "https://dropbox.losthusky.qzz.io",
    "INDEX_CHUNK": "200",
    "CHANGE_WINDOW_SEC": "300",
    "INDEX_SCHEDULE": "daily"
  },
  "routes": [{ "pattern": "dropbox.losthusky.qzz.io", "custom_domain": true }],
  // Nightly at 22:45 UTC (04:15 IST): recurring image-archive rules.
  "triggers": { "crons": ["45 22 * * *"] },
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  }
}
